# =========================================================
# Annapurna-AI Local Configuration
# =========================================================
# Copy this file to backend/.env and adjust as needed.
# Most defaults work out of the box with Ollama.

# --- LLM Settings (Local-First Defaults) ---
# Provider: ollama | lmstudio | llamacpp | custom
LLM_PROVIDER=ollama

# Base URL for LLM API
# - Ollama default: http://localhost:11434
# - LM Studio default: http://localhost:1234/v1
# - llama.cpp default: http://localhost:8080/v1
LLM_BASE_URL=http://localhost:11434

# Model name to use
# - For Ollama: llama3.2:latest, mistral:latest, phi3:latest, etc.
# - For LM Studio: Use the model name shown in the UI
# - For llama.cpp: Use the model filename
LLM_MODEL=llama3.2:latest

# API key (usually "not-needed" for local LLMs)
# Only required for OpenAI-compatible endpoints that need auth
LLM_API_KEY=not-needed

# --- Database (Local SQLite) ---
# SQLite database file path
# Default creates annapurna.db in the backend directory
DATABASE_URL=sqlite+aiosqlite:///./annapurna.db

# --- Optional External APIs (DISABLED by default for privacy) ---
# Enable USDA nutrition lookups (requires internet + API key)
ENABLE_USDA=false

# USDA FoodData Central API Key
# Get yours at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Enable PubMed evidence search (requires internet)
ENABLE_PUBMED=false

# --- Legacy Settings (kept for compatibility) ---
# Not used in local mode
OPENAI_API_KEY=
