# Annapurna-AI local configuration template.
# Copy to backend/.env for the FastAPI backend.
# Copy only the frontend variables you need to .env.local for Next.js.

# Runtime mode: development, test, or production.
APP_ENV=development

# Keep false unless you are actively debugging local errors.
DEBUG=false

# Comma-separated browser origins allowed to call the backend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local SQLite database. This file is ignored by Git.
DATABASE_URL=sqlite+aiosqlite:///./annapurna.db

# Local LLM provider: ollama, lmstudio, llamacpp, or custom.
LLM_PROVIDER=ollama

# Ollama default endpoint.
LLM_BASE_URL=http://localhost:11434

# Non-local/cloud model endpoints are blocked unless ENABLE_EXTERNAL_NETWORK=true.
# In cloud mode, family profile, pantry, and dietary prompt text may leave this device.
# Example external endpoint:
# LLM_BASE_URL=https://api.openai.com/v1

# Default local model. Pull it with: ollama pull llama3.2:latest
LLM_MODEL=llama3.2:latest

# Optional API key for OpenAI-compatible local servers that require auth.
LLM_API_KEY=

# Master switch for optional non-local fetchers.
ENABLE_EXTERNAL_NETWORK=false

# Optional USDA FoodData Central fetcher. Disabled by default.
ENABLE_USDA=false

# Required only when ENABLE_USDA=true and ENABLE_EXTERNAL_NETWORK=true.
USDA_API_KEY=

# Optional PubMed fetcher. Disabled by default.
ENABLE_PUBMED=false

# Recommended when ENABLE_PUBMED=true and required by config validation.
PUBMED_EMAIL=

# Next.js server-side rewrite target. Do not put secrets here.
BACKEND_URL=http://127.0.0.1:8000

# Browser-visible API route prefix. This is not a secret.
NEXT_PUBLIC_API_BASE_PATH=/api/python
